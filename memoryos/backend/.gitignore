# ===================================
# MemoryOS Backend — .gitignore
# ===================================

# --- Environment / Secrets (NEVER commit — Rules.md §2) ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
dist/
build/

# --- Virtual environment ---
venv/
.venv/
env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
coverage/

# --- Alembic ---
alembic/versions/__pycache__/

# --- Test scripts ---
test_*.py

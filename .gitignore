# ===========================
# MemoryOS — Root .gitignore
# ===========================

# --- Environment / Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
venv/
.venv/
env/

# --- Node ---
node_modules/
.next/
dist/
dist-ssr/
.turbo/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
coverage/

# --- Alembic ---
alembic/versions/__pycache__/

# --- Test scripts ---
test_*.py

# --- Binary / Large files ---
*.docx
*.xlsx
*.pptx
*.zip
*.tar.gz
